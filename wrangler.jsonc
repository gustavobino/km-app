{
  // Cloudflare Workers (free plan) via OpenNext. See docs/cloudflare.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "km-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Keep the variables set in the Cloudflare dashboard on every deploy
  // (ADMIN_EMAILS, LEGAL_CONTROLLER_NAME…); secrets are always kept.
  "keep_vars": true,
  // Public, non-secret settings. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_WEBHOOK_SECRET) are set with
  // `wrangler secret put` or in the Cloudflare dashboard, never here.
  "vars": {
    "PRICE_BRL_CENTS": "1790",
    // Mercado Pago blocks requests from Workers: go through the Supabase relay
    // (supabase/functions/mp-relay). Not a secret.
    "MERCADOPAGO_API_BASE": "https://bguifsyabtcvinzaajcy.supabase.co/functions/v1/mp-relay"
  }
}
