# Km+ — copie para .env.local e preencha. Nunca commite .env.local.
# Variáveis NEXT_PUBLIC_* vão para o navegador: só coloque nelas o que pode ser público.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://bguifsyabtcvinzaajcy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Liga o login por código de 6 dígitos. Só funciona depois de configurar um
# provedor de e-mail (SMTP) e o modelo db/auth-templates/login.html no Supabase.
NEXT_PUBLIC_AUTH_OTP_CODE=true
# SECRETA: só no servidor (Vercel → Environment Variables). Nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Compra única ---
# Preço em centavos (R$ 17,90).
PRICE_BRL_CENTS=1790

# --- Mercado Pago (M7; credenciais de TESTE primeiro) ---
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# SECRETAS:
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Only on Cloudflare (set in wrangler.jsonc): Mercado Pago through the Supabase relay.
# MERCADOPAGO_API_BASE=https://<ref>.supabase.co/functions/v1/mp-relay

# --- Admin (M7): e-mails separados por vírgula com acesso a /admin ---
ADMIN_EMAILS=

# --- Textos legais (Termos e Privacidade) ---
# Nome do responsável pelos dados (controlador, LGPD) e e-mail público de contato.
LEGAL_CONTROLLER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Testes (opcional) ---
# Caminho de um Chromium já instalado para o Playwright.
PW_CHROMIUM_PATH=
